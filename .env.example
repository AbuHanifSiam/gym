# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include a database name, e.g. /gym
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gym?retryWrites=true&w=majority
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me
# Set to "false" after you have created your account to block public sign-ups
ALLOW_REGISTRATION=true
